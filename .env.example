# Copy to .env and adjust. Never commit .env. No real values here.

# --- Published ports on the host (port 80 is intentionally not used) ---
ACP_HTTP_PORT=8080
ACP_HTTPS_PORT=8443

# --- Database ---
# Password of the postgres user "acp" (generate: openssl rand -hex 24).
ACP_DB_PASSWORD=change-me

# --- Logging: debug | info | warn | error ---
ACP_LOG_LEVEL=info

# External base URL of the app (scheme://host[:port], no path). Required for
# OIDC redirects; with TLS enabled, plain HTTP requests redirect here.
ACP_PUBLIC_URL=https://acp.example.com:8443

# --- OIDC login (ADR-0006) ---
# Optional; both issuer and client ID enable OIDC. PKCE public client, no secret.
# Redirect URI to register at the IdP: <ACP_PUBLIC_URL>/api/auth/oidc/callback
# Post-logout redirect URI: <ACP_PUBLIC_URL>/login
ACP_OIDC_ISSUER=
ACP_OIDC_CLIENT_ID=
# ACP_OIDC_SCOPES=openid profile email
# ACP_OIDC_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
# ACP_SESSION_IDLE_TIMEOUT=8h
# ACP_SESSION_ABSOLUTE_TIMEOUT=24h
# Local break-glass admin (argon2id + TOTP); create it with `acp admin create-breakglass`.
# ACP_BREAKGLASS_ENABLED=true

# --- TLS (ADR-0011) ---
# Optional. Leave empty for plain HTTP. To enable HTTPS, put the files below
# ./secrets/ and set both ACP_TLS_*_SECRET (host paths, mounted as Docker
# secrets) and ACP_TLS_*_FILE (paths inside the container).
# Example host name for the certificate: acp.example.com
ACP_TLS_CERT_SECRET=./deploy/empty
ACP_TLS_KEY_SECRET=./deploy/empty
ACP_TLS_CERT_FILE=
ACP_TLS_KEY_FILE=
# Example for HTTPS:
# ACP_TLS_CERT_SECRET=./secrets/tls/acp.example.com.crt
# ACP_TLS_KEY_SECRET=./secrets/tls/acp.example.com.key
# ACP_TLS_CERT_FILE=/run/secrets/tls_cert
# ACP_TLS_KEY_FILE=/run/secrets/tls_key

# --- Master key ---
# Not set here: the file ./secrets/master.key (mode 600) is mounted as Docker
# secret. Create it with: make init   (or: openssl rand -base64 32 > secrets/master.key)

# --- Worker ---
# Shared bearer token of the internal worker API: ./secrets/worker.token
# (created by `make init`, mounted as Docker secret in app and worker, owned by
# uid 10001, mode 600). Without it the app serves no worker API and runs stay queued.
# Parallel runs per worker container (default 2; the host is small).
# ACP_WORKER_CONCURRENCY=2

# --- Advanced (defaults are set in docker-compose.yml) ---
# ACP_HTTP_ADDR=:8080
# ACP_HTTPS_ADDR=:8443
# ACP_DATABASE_URL=postgres://acp:<password>@postgres:5432/acp?sslmode=disable
# ACP_APP_URL=http://app:8080            # worker: where to reach the app
# ACP_DATA_DIR=/var/lib/acp              # Git clone cache (compose volume acpdata)
# ACP_WORKER_ADDR=:8081                  # worker health listener
# ACP_WORKER_POLL_INTERVAL=15s
# ACP_SHUTDOWN_GRACE=15s
