# syntax=docker/dockerfile:1
ARG GO_IMAGE=golang:1.27.2-alpine3.24
ARG PYTHON_IMAGE=python:3.14.9-slim-trixie

FROM ${GO_IMAGE} AS build
ARG VERSION=dev
ARG COMMIT=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X github.com/BxnnyG/ansible-control-plane/internal/version.Version=${VERSION} -X github.com/BxnnyG/ansible-control-plane/internal/version.Commit=${COMMIT}" \
      -o /out/acp ./cmd/acp

FROM ${PYTHON_IMAGE}
ARG ANSIBLE_CORE_VERSION=2.21.5
RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir "ansible-core==${ANSIBLE_CORE_VERSION}" \
 && useradd --uid 10001 --create-home --home-dir /home/acp --shell /usr/sbin/nologin acp
COPY --from=build /out/acp /usr/local/bin/acp
USER acp
ENV HOME=/home/acp \
    ANSIBLE_LOCAL_TEMP=/tmp/ansible-local \
    ANSIBLE_REMOTE_TEMP=/tmp/ansible-remote \
    PYTHONDONTWRITEBYTECODE=1
EXPOSE 8081
ENTRYPOINT ["acp"]
CMD ["worker"]
